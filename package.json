{
  "name": "ferah-nefes",
  "version": "0.2.0",
  "private": true,
  "description": "Ferah Nefes · Sinüs Bulmacası: tarayıcı tabanlı bulmaca oyunu (Vite + TypeScript + PixiJS)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix tools/eslint --no-audit --no-fund",
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/eslint/node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node tools/eslint/node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "pixi.js": "7.4.2"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
