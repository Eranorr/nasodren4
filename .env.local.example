# Supabase (sitedeki bütün oyunların ortak projesi; bu oyunun öneki: tetris).
# Yerel geliştirme için bu dosyayı .env.local olarak kopyalayıp doldurun (.env.local Git'e eklenmez).
# Değerler boşsa global skor çevrimdışıdır ve çok oyunculu gizlenir; oyun ve yerel skor listesi çalışır.
#
# YALNIZCA public değerler: proje URL'si ve publishable (sb_publishable_…) ya da anon anahtar.
# Service role / secret anahtarı (sb_secret_… veya service_role JWT) ASLA yazılmaz; uygulama bunu reddeder.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
